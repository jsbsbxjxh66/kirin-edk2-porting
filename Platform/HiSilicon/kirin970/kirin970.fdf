!endif

FILE FREEFORM = 4b0364cf-1c5b-47aa-9073-d7b5039ce49b {
  SECTION RAW = Platform/HiSilicon/kirin970/simpleinit.static.uefi.cfg
  SECTION UI = "simpleinit.static.uefi.cfg"
}

!if $(ENABLE_LINUX_UTILS) == 1
  INF Platform/RenegadePkg/Application/Reboot2PayloadApp/Reboot2PayloadApp.inf
!endif

# Mainline Linux kernel in FV
# To enable: set MAINLINE_KERNEL_IN_FV = 1 in kirin970.dsc
# and increase FD_SIZE in configs/kirin970.conf (see comments there)
# Place files at: mainline/Image.lz4, mainline/kirin970.dtb, mainline/initrd.img
!if $(MAINLINE_KERNEL_IN_FV) == 1
  FILE FREEFORM = 1d5b842e-5a63-4e42-b87c-6a9c1e4f3d8a {
    SECTION RAW = mainline/Image.lz4
    SECTION UI = "Image.lz4"
  }

  FILE FREEFORM = 2e6c953f-6b74-4f53-c98d-7bae2f5e4c9b {
    SECTION RAW = mainline/kirin970.dtb
    SECTION UI = "kirin970.dtb"
  }

  FILE FREEFORM = 3f7da640-7c85-4064-da9e-8cbf3e6f5dac {
    SECTION RAW = mainline/initrd.img
    SECTION UI = "initrd.img"
  }
!endif

# Device specific fdf
!include $(DEVICE_DXE_FV_COMPONENTS)

[FV.FVMAIN_COMPACT]
FvAlignment        = 8
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

  INF Silicon/HiSilicon/kirin970/KirinPkg/PrePi/PrePi.inf

  FILE FV_IMAGE = 9E21FD93-9C72-4c15-8C4B-E77F1DB2D792 {
    SECTION GUIDED EE4E5898-3914-4259-9D6E-DC7BD79403CF PROCESSING_REQUIRED = TRUE {
      SECTION FV_IMAGE = FVMAIN
    }
  }

